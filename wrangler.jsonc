{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anyang-badminton",
  "compatibility_date": "2026-01-30",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "badminton-db-production",
      "database_id": "6643eb8f-91a5-4bdd-9743-a78d74852253"
    }
  ]
  // R2 바인딩은 나중에 추가 예정
  // 환경 변수 설정 (SMS 발송):
  // 로컬 개발: .dev.vars 파일에 설정
  // 프로덕션: wrangler secret put 명령어로 설정
  //   - SOLAPI_API_KEY: 솔라피 API Key
  //   - SOLAPI_API_SECRET: 솔라피 API Secret
  //   - SOLAPI_SENDER: 발신번호 (예: 01012345678)
  //
  // 테스트 모드: 환경 변수가 없으면 자동으로 시뮬레이션 모드로 작동
}